# =============================================================================
# DataMgmt Production Environment Variables
# =============================================================================
# 复制此文件为 .env.prod 并填入实际值
# IMPORTANT: 不要将此文件提交到版本控制系统！

# ----- PostgreSQL -----
POSTGRES_USER=examuser
POSTGRES_PASSWORD=changeme-secure-password-here
POSTGRES_DB=examdb
POSTGRES_PORT=5432

# ----- Backend -----
# 数据库连接字符串
DATABASE_URL=postgresql://examuser:changeme-secure-password-here@postgres:5432/examdb

# JWT 配置（必须修改！建议使用 64 位随机字符串）
# 生成方法: openssl rand -base64 64
JWT_SECRET=changeme-use-openssl-rand-base64-64
JWT_EXPIRES_IN=24h

# 允许的跨域来源（前端域名，逗号分隔，不带尾部斜杠）
# 本地开发: http://localhost:3001
# 生产环境: https://your-domain.com
ALLOWED_ORIGINS=http://localhost:3001,https://your-domain.com

# ----- Frontend -----
# API 地址（反代后的地址）
NEXT_PUBLIC_API_URL=http://localhost

# ----- Ports -----
HTTP_PORT=80
HTTPS_PORT=443
